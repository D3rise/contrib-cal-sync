{
  "name": "contrib-cal-sync",
  "version": "1.0.0",
  "description": "Mirror a private GitLab contribution calendar into GitHub on macOS.",
  "type": "module",
  "bin": {
    "contrib-cal-sync": "dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node --test --test-reporter=spec .test-dist/test/*.test.js",
    "build:helper": "bash scripts/build-helper.sh"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
